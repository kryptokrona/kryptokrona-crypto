{
  "name": "kryptokrona-crypto",
  "version": "2.0.0",
  "description": "Kryptokrona cryptographic functions for Node.js, Electron and React Native, on the crypto core of the Kryptokrona node",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "react-native": "dist/react-native.js",
  "files": [
    "dist/",
    "spec/",
    "cpp/",
    "ios/",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/src/",
    "prebuilt/",
    "kryptokrona-crypto.podspec",
    "react-native.config.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build-typescript": "tsc",
    "build-napi": "napi build --platform --release --cargo-cwd rust/napi --js false --dts kryptokrona-crypto.d.ts prebuilt/napi",
    "build-napi-debug": "napi build --platform --cargo-cwd rust/napi --js false --dts kryptokrona-crypto.d.ts prebuilt/napi",
    "build-android": "./scripts/build-android.sh",
    "build-ios": "./scripts/build-ios.sh",
    "docs": "typedoc && touch docs/.nojekyll && git restore docs/CNAME",
    "prepublishOnly": "npm run build && npm test",
    "style": "eslint typescript/*.ts spec/*.ts tests/*.ts",
    "fix-style": "eslint --fix typescript/*.ts spec/*.ts tests/*.ts",
    "test": "npm run test-node && npm run test-react-native && npm run test-react-native-module",
    "test-node": "mocha --timeout 60000 --require ts-node/register tests/crypto.ts",
    "test-react-native": "mocha --timeout 60000 --require ts-node/register tests/react-native.ts",
    "test-react-native-module": "mocha --timeout 60000 --require ts-node/register tests/react-native-module.ts",
    "test-rust": "cd rust && cargo test -p kryptokrona-crypto-extra",
    "benchmark": "node tests/benchmark.js"
  },
  "codegenConfig": {
    "name": "KryptokronaCryptoSpec",
    "type": "modules",
    "jsSrcsDir": "spec",
    "android": {
      "javaPackageName": "se.kryptokrona.crypto"
    },
    "ios": {
      "modulesProvider": {
        "KryptokronaCrypto": "KryptokronaCryptoProvider"
      }
    }
  },
  "napi": {
    "name": "kryptokrona-crypto",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kryptokrona/kryptokrona-crypto.git"
  },
  "bugs": {
    "url": "https://github.com/kryptokrona/kryptokrona-crypto/issues"
  },
  "engines": {
    "node": ">=12.17"
  },
  "engineStrict": true,
  "homepage": "https://kryptokrona.se",
  "author": "The Kryptokrona Developers",
  "license": "GPL-3.0",
  "dependencies": {
    "js-sha3": "^0.8.0"
  },
  "peerDependencies": {
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "2.18.4",
    "@types/mocha": "^8.0.2",
    "@types/node": "^14.0.27",
    "@typescript-eslint/eslint-plugin": "^3.9.0",
    "@typescript-eslint/parser": "^3.9.0",
    "eslint": "^7.7.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "mocha": "^8.1.1",
    "run-script-os": "^1.1.1",
    "ts-node": "^8.10.2",
    "typedoc": "^0.18.0",
    "typescript": "^3.9.7"
  }
}
